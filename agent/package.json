{
  "name": "mk-nasd",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "description": "The mk-nas root agent: an allow-list of ZFS, SMART and share verbs over a Unix socket. Node 24, no build step, no shell.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "MK_NAS_SOCKET=${MK_NAS_SOCKET:-/tmp/mk-nas.sock} MK_NAS_AUDIT=- node --watch src/index.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2"
  }
}
