[Unit]
Description=mk-nas agent (mk-nasd)
After=zfs.target
Wants=zfs.target

[Service]
Type=simple
ExecStart=/opt/mk-nas/node/bin/node /opt/mk-nas/agent/src/index.ts
Environment=NODE_NO_WARNINGS=1
Environment=MK_NAS_SOCKET=/run/mk-nas.sock
Environment=MK_NAS_AUDIT=/var/log/mk-nas/audit.jsonl
# no EnvironmentFile for the stack's .env (/opt/mk-drive/.env): it is the drive's, a settings restore writes it, and
# a variable there such as NODE_OPTIONS would run code in this root process; config.ts reads DRIVE_UID/DRIVE_GID
# from it (who owns what the agent makes for the container) and nothing else
Restart=on-failure
RestartSec=2
User=root
NoNewPrivileges=true
# no ProtectHome / PrivateTmp: both give the service its own mount namespace, and a
# pool or dataset the agent mounts would then be invisible to the host and the container

[Install]
WantedBy=multi-user.target
