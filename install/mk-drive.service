[Unit]
Description=mk-drive (the NAS console) as a compose stack
# the socket file must be there before the container mounts it (docker would make a directory in its place); the agent
# itself is only wanted: it restarts on every mk-nas update, and the stack must not go down with it
Requires=docker.service mk-nasd.socket
After=docker.service mk-nasd.socket mk-nasd.service network-online.target
Wants=mk-nasd.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/mk-drive
ExecStartPre=/opt/mk-nas/install/load-image.sh
# the drive, and the Cloudflare Tunnel when .env has a token (stack-up.sh)
ExecStart=/opt/mk-nas/install/stack-up.sh
ExecStop=/usr/bin/docker compose --profile tunnel down
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
